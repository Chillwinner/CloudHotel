server:
  port: 8081

spring:
  application:
    name: hotel-user-service
  cloud:
    nacos:
      # 这里的地址必须写对，确保本地 Docker Nacos 正在运行
      server-addr: 127.0.0.1:8848
      discovery:
        server-addr: ${spring.cloud.nacos.server-addr}
        service: ${spring.application.name}

  datasource:
    # 确保本地 MySQL 中已经执行了 CREATE DATABASE hotel_db
    url: jdbc:mysql://127.0.0.1:3306/hotel_db?useUnicode=true&characterEncoding=UTF-8&useSSL=false&serverTimezone=Asia/Shanghai
    username: root
    password: <your-mysql-password>
    driver-class-name: com.mysql.cj.jdbc.Driver

mybatis:
  mapper-locations: classpath:mapper/*.xml
  type-aliases-package: com.Aura.new_Hotel.entity
  configuration:
    map-underscore-to-camel-case: true
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl

logging:
  level:
    com.aura.hotel.mapper: debug

springdoc:
  api-docs:
    path: /api-docs
  swagger-ui:
    path: /swagger-ui.html
    operations-sorter: alpha
  packages-to-scan: com.aura.hotel.Controller

sky:
  alioss:
    endpoint: oss-cn-shenzhen.aliyuncs.com
    access-key-id: <your-aliyun-access-key-id>
    access-key-secret: <your-aliyun-access-key-secret>
    bucket-name: <your-oss-bucket-name>
